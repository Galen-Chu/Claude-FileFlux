# FileFlux environment configuration
# Copy this file to `.env` and fill in your values.

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------
# Required for production. Dev falls back to an insecure key if unset.
DJANGO_SECRET_KEY=
# Set to False in production.
DEBUG=True
# Comma-separated list of allowed hosts.
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Token-at-rest encryption (Fernet urlsafe base64)
# ---------------------------------------------------------------------------
# If unset, a key is derived from DJANGO_SECRET_KEY (fine for dev).
# Generate one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILEFLUX_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# AWS S3
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY=your_aws_access_key_here
AWS_SECRET_KEY=your_aws_secret_key_here
BUCKET_NAME=your_s3_bucket_name_here
AWS_REGION=us-east-1
# Optional: endpoint for S3-compatible services (leave empty for real AWS S3).
# Example (docker-compose MinIO): S3_ENDPOINT_URL=http://minio:9000
S3_ENDPOINT_URL=

# ---------------------------------------------------------------------------
# Local storage
# ---------------------------------------------------------------------------
LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=100

# ---------------------------------------------------------------------------
# Google Drive OAuth (https://console.cloud.google.com/ → enable Drive API)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Microsoft OneDrive OAuth (https://portal.azure.com/ → app registration)
# ---------------------------------------------------------------------------
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common

# ---------------------------------------------------------------------------
# OAuth callback (must match the redirect URI registered with each provider)
# ---------------------------------------------------------------------------
OAUTH_REDIRECT_URI=http://localhost:8000/oauth/callback/
